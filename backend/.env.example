# Server
NODE_ENV=development
PORT=3000
COOKIE_SECRET=change-me-in-production-min-32-chars
# Session/CSRF cookies get `Secure` automatically when NODE_ENV=production or the request came
# over HTTPS (incl. X-Forwarded-Proto from a loopback reverse proxy). Leave unset normally;
# COOKIE_SECURE=true forces it on, COOKIE_SECURE=false forces it off (plain-HTTP LAN testing only).
# COOKIE_SECURE=

# MongoDB
MONGO_URI=mongodb://localhost:27017/garment_erp

# Sessions — 30 days so people stay logged in between visits; idle timeout matches so a
# session isn't cut short just from going a few hours/days between opens (only the 30-day
# absolute cap forces a fresh login).
SESSION_IDLE_TIMEOUT_MINUTES=43200
SESSION_ABSOLUTE_TIMEOUT_HOURS=720

# Argon2id (raise these over time; see docs/adr)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Company / numbering defaults used by the seed script
COMPANY_LEGAL_NAME=Demo Garment Co
COMPANY_STATE=Maharashtra
COMPANY_GSTIN=27AAAAA0000A1Z5
CURRENT_FINANCIAL_YEAR=26-27

# CORS: comma-separated allowlist of frontend origins - never a wildcard (NFR-04)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary (design photos, purchase attachments - PUR-07)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
